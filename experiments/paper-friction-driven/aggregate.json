    },
    "distinct_structures": {
      "definition": "distinct expression structures among the evaluated candidates",
      "label": "distinct structures",
      "unit": "-"
    },
    "elapsed_s": {
      "definition": "elapsed execution time of the round, without the final checks and the evaluation",
      "label": "elapsed execution time",
      "unit": "s"
    },
    "evaluated_candidates": {
      "definition": "candidates within the pool limit that passed the checks and were evaluated",
      "label": "evaluated candidates",
      "unit": "-"
    },
    "input_tokens": {
      "definition": "input tokens of all requests of the run",
      "label": "input tokens",
      "unit": "tokens"
    },
    "oracle_best_S": {
      "definition": "smallest S among the eligible candidates of the run; selects on the test data and measures whether the pool contains an accurate model",
      "label": "best eligible test score S in the pool (oracle-based selection on test data)",
      "unit": "output"
    },
    "output_tokens": {
      "definition": "output tokens (including reasoning tokens) of all responses",
      "label": "output tokens",
      "unit": "tokens"
    },
    "pool_size": {
      "definition": "candidates proposed in the final pool",
      "label": "pool size",
